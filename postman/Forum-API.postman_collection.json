{
  "info": {
    "name": "Forum API \u2014 all homework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "authorId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Register user 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"one@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register user 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"two@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"one@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"coding\"\n}"
        },
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "List categories",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "Create post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"First post\",\n  \"content\": \"Hello forum\",\n  \"categoryId\": {{categoryId}},\n  \"authorId\": {{authorId}}\n}"
        },
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "List posts with category and author",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "Filter posts by category name",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts?category=coding"
      }
    },
    {
      "name": "Get post by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts/1"
      }
    }
  ]
}